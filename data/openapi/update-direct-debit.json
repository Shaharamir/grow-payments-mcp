 "openapi": "3.0.0",
 "info": {
  "title": "grow documentation",
  "version": "1.0.0"
 },
 "servers": [
  {
   "url": "https://sandbox.meshulam.co.il"
  }
 ],
 "paths": {
  "/api/light/server/1.0/updateDirectDebit": {
   "post": {
    "tags": [
     "default"
    ],
    "summary": "Update Recurring Payment",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "type": "object",
        "properties": {
         "userId": {
          "type": "string",
          "description": "Required field -Unique identifier refers to every business that is connected and uses Grow payments solutions.",
          "example": "2b2e9b70fc98dc6f"
         },
         "transactionToken": {
          "type": "string",
          "description": "Required field -transaction identifier\n",
          "example": "94d4a5095f56521c5adbb0c906efbeb2"
         },
         "transactionId": {
          "type": "integer",
          "description": "Required field -transaction identifier",
          "example": "32627825"
         },
         "asmachta": {
          "type": "integer",
          "description": "Required field - An approval from the credit card company for the payment",
          "example": "295616074"
         },
         "fullName": {
          "type": "string",
          "description": "optional-Full name must consist of at least two names.",
          "example": "Israel israeli"
         },
         "phone": {
          "type": "string",
          "description": "optional -A valid israeli mobile phone numebr Example: 0500000000 "
         },
         "chargeDay": {
          "type": "integer",
          "description": "optional - 1-31",
          "example": "10"
         },
         "sum": {
          "type": "integer",
          "description": "optional - Total amount for payment Example: 10.99.",
          "example": "12"
         },
         "paymentNum": {
          "type": "integer",
          "description": "optional - 1-48",
          "example": "10"
         },
         "email": {
          "type": "string",
          "description": "optional -A valid email address",
          "example": "changeEmail@gmail.com"
         },
         "changeStatus": {
          "type": "integer",
          "description": "optional -\n1= active 2= canceled",
          "example": "1"
         },
         "updateCard": {
          "type": "integer",
          "description": "optional -\n0= no update 1=update",
          "example": "0"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful response",
      "content": {
       "application/json": {}
      }
     }
    },
    "description": "This method is for updating an existing direct debit payment .   Each business has its own unique identifiers - the identifiers on this documentation are for example only.  To integrate with the API, please contact Grow support to obtain the necessary permissions and your unique identifiers."
   }
  }
 },
 "x-readme": {
  "explorer-enabled": true,
  "proxy-enabled": true
 }
}